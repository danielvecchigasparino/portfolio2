      <g filter="url(#w)">
        <path class="ln" d="M60 250 L740 250"/>
        <path class="ln" d="M365 330 L400 252 L435 330 Z"/>
        <circle class="dotc" id="d-cobasi" cx="130" cy="228" r="14"/>
        <circle class="dotc" id="d-petz" cx="225" cy="228" r="14"/>
        <circle class="dotc" id="d-chewy" cx="320" cy="228" r="14"/>
