<title>Pet & Pet — planejamento estratégico de marketing</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;700&family=Caveat:wght@600&display=swap">
<style>
:root{--bg:#fafafa;--fg:#0a0a0a;--mute:#5c5c5c;--line:#d9d9d9;--acc:#e10600;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){color-scheme:dark;--bg:#0a0a0a;--fg:#fafafa;--mute:#a3a3a3;--line:#333;--acc:#ff4b43}}
:root[data-theme="dark"]{color-scheme:dark;--bg:#0a0a0a;--fg:#fafafa;--mute:#a3a3a3;--line:#333;--acc:#ff4b43}
*{box-sizing:border-box;margin:0}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
body{background:var(--bg);color:var(--fg);font:400 clamp(17px,1.6vw,21px)/1.5 "Instrument Sans","Helvetica Neue",Arial,sans-serif;-webkit-font-smoothing:antialiased}
section{min-height:100vh;padding:clamp(36px,7vw,96px) clamp(24px,7vw,110px);display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden}
section.hoje{background:var(--bg)}
section.pode{background:#000;color:#fafafa;--fg:#fafafa;--mute:#b5b5b5;--line:#333;--acc:#ff4b43}
h1,h2{font-weight:400;letter-spacing:-.035em;line-height:1}
h1{font-size:clamp(46px,8.6vw,132px)}
h2{font-size:clamp(34px,5.6vw,84px);max-width:15em}
b{font-weight:700}
.sub{margin-top:28px;font-size:clamp(17px,1.8vw,24px);color:var(--mute)}
.red{color:var(--acc)}
.pill{display:inline-block;border:2px solid var(--fg);border-radius:999px;padding:.3em 1em;font:inherit;color:inherit;background:none;font-size:clamp(16px,1.7vw,22px);cursor:pointer;transition:background .2s,color .2s}
.pill[aria-pressed="true"]{background:var(--fg);color:var(--bg)}
.pill:focus-visible{outline:3px solid var(--acc);outline-offset:4px}
.mark{font-family:"Caveat","Segoe Print",cursive;font-weight:600}
.state{max-width:20em;font-size:clamp(28px,4.4vw,64px);letter-spacing:-.03em;line-height:1.08}
.tag{position:fixed;right:max(14px,env(safe-area-inset-right,0px));bottom:max(14px,env(safe-area-inset-bottom,0px));background:#e10600;color:#fff;font-size:13px;padding:6px 12px;border-radius:999px;z-index:5}
/* desenho */
.draw{width:100%;max-width:860px;margin-top:36px}
.draw svg{width:100%;height:auto;display:block;overflow:visible}
.draw text{fill:var(--fg)}
.draw .ln{fill:none;stroke:var(--fg);stroke-width:4;stroke-linecap:round;stroke-linejoin:round}
.dotc{fill:var(--bg);stroke:var(--fg);stroke-width:4;transition:fill .25s,r .25s}
.dotc.on{fill:var(--acc);stroke:var(--acc)}
.brands{display:flex;flex-wrap:wrap;gap:12px;margin-top:20px}
.panel{margin-top:22px;max-width:36em;min-height:6.2em;font-size:clamp(18px,2vw,26px);letter-spacing:-.015em;line-height:1.3}
/* ranking */
ol{list-style:none;margin-top:44px;padding:0;border-top:2px solid var(--fg);max-width:980px}
li.rk{display:flex;gap:clamp(16px,4vw,48px);align-items:baseline;padding:20px 0;border-bottom:1px solid var(--line)}
li.rk .n{font-size:clamp(40px,6vw,84px);font-weight:700;letter-spacing:-.05em;line-height:1;min-width:1.2em}
li.rk strong{display:block;font-size:clamp(22px,3vw,40px);letter-spacing:-.03em;line-height:1.1}
li.rk span{color:var(--mute)}
.steps{display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,4vw,64px);margin-top:44px;max-width:1000px}
.steps div{border-top:2px solid var(--fg);padding-top:14px;font-size:clamp(18px,2vw,26px);letter-spacing:-.015em;line-height:1.3}
.steps b{display:block;font-size:clamp(28px,4vw,52px);letter-spacing:-.04em;margin-bottom:6px}
.cover{padding:0}.cover .top{flex:1;padding:clamp(36px,7vw,96px) clamp(24px,7vw,110px);display:flex;flex-direction:column;justify-content:flex-end;border-bottom:1px solid var(--line)}.cover .bot{flex:1;background:#000;color:#fafafa;--fg:#fafafa;--bg:#000;padding:clamp(24px,5vw,56px) clamp(24px,7vw,110px);display:flex;flex-direction:column;justify-content:space-between;align-items:flex-start;gap:24px}.cover .bot .nm{font-size:clamp(30px,4.4vw,60px);letter-spacing:-.03em}
.rows{margin-top:44px;border-top:2px solid var(--fg);max-width:1000px}.rows p{padding:22px 0;border-bottom:1px solid var(--line);font-size:clamp(22px,3vw,40px);letter-spacing:-.03em;line-height:1.15}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:24px;margin-top:36px}.stats div{border-top:2px solid var(--fg);padding-top:12px}.stats b{display:block;font-size:clamp(48px,7vw,104px);letter-spacing:-.05em;line-height:1}.stats span{display:block;color:var(--mute);font-size:16px;margin-top:6px}
.txt{max-width:42em;color:var(--mute);margin-top:30px;font-size:clamp(16px,1.5vw,19px)}.txt p+p{margin-top:12px}
.chk{list-style:none;padding:0;margin-top:34px;columns:2 340px;column-gap:48px;max-width:1000px}.chk li{break-inside:avoid;display:flex;gap:14px;align-items:center;padding:11px 0;border-bottom:1px solid var(--line);font-size:clamp(18px,2vw,26px);letter-spacing:-.015em;color:var(--mute)}.chk i{flex:none;width:26px;height:26px;border:2px solid var(--line);border-radius:6px;position:relative}.chk li.ok{color:var(--fg)}.chk li.ok i{background:var(--fg);border-color:var(--fg)}.chk li.ok i:after{content:"";position:absolute;left:7px;top:2px;width:7px;height:13px;border:solid var(--bg);border-width:0 3px 3px 0;transform:rotate(45deg)}
.j3{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(18px,3vw,44px);margin-top:20px}.j3 div{font-size:clamp(17px,1.8vw,23px);line-height:1.35}.j3 b{display:block;font-size:clamp(28px,3.6vw,48px);letter-spacing:-.04em;margin-bottom:6px}
.ig{display:grid;grid-template-columns:minmax(150px,240px) 1fr;gap:clamp(24px,5vw,72px);align-items:center;margin-top:34px}.ig svg{width:100%;height:auto}.sq{fill:none;stroke:var(--fg);stroke-width:3;transition:fill .25s,stroke .25s}.sq.on{fill:var(--acc);stroke:var(--acc)}.stage{padding:16px 0;border-top:2px solid var(--fg);cursor:pointer}.stage:focus-visible{outline:3px solid var(--acc);outline-offset:4px}.stage b{display:block;font-size:clamp(24px,3vw,40px);letter-spacing:-.03em;margin-bottom:6px;transition:color .25s}.stage.on b{color:var(--acc)}.stage span{color:var(--mute)}
@media (max-width:720px){.j3,.ig,.fun{grid-template-columns:1fr}.ig svg{max-width:170px}.fun .draw{max-width:300px}}
.fun{display:grid;grid-template-columns:minmax(220px,360px) 1fr;gap:clamp(24px,5vw,72px);align-items:start;margin-top:32px}
.calw{overflow-x:auto;margin-top:22px}.cal{display:grid;grid-template-columns:repeat(7,minmax(88px,1fr));min-width:640px;border-top:2px solid var(--fg);border-left:1px solid var(--line)}.wd{padding:8px;color:var(--mute);font-size:14px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.cd{min-height:96px;padding:6px 8px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;flex-direction:column;align-items:flex-start;gap:5px}.dn{font-size:14px;color:var(--mute)}.ev{font-size:12px;color:var(--acc)}.ch{display:inline-block;padding:2px 10px;border-radius:999px;font-size:13px;line-height:1.3;border:1.5px solid var(--fg)}.ch.i{background:var(--fg);color:var(--bg)}.ch.p{border-style:dashed}.ch.r{background:var(--acc);border-color:var(--acc);color:#fff}.lg{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px;align-items:center}.cl{list-style:none;padding:0;margin-top:24px;columns:2 360px;column-gap:40px}.cl li{break-inside:avoid;padding:9px 0;border-bottom:1px solid var(--line);font-size:clamp(15px,1.5vw,18px)}.cl b{margin-right:6px}
.band,.bar{fill:none;stroke:var(--fg);stroke-width:4;stroke-linejoin:round;cursor:pointer;transition:fill .25s,stroke .25s}.band.on,.bar.on{fill:var(--acc);stroke:var(--acc)}
.bt,.bl{font-family:"Caveat","Segoe Print",cursive;font-weight:600;pointer-events:none}.bt{font-size:30px;text-anchor:middle}.bl{font-size:28px}.draw text.w{fill:#fff}
.fp{min-height:18em;margin-top:22px}.fp h3{font-weight:700;font-size:clamp(28px,3.6vw,48px);letter-spacing:-.04em;line-height:1.1}.fp h3 span{font-weight:400;color:var(--mute);font-size:.55em;letter-spacing:-.02em;display:block;margin-top:4px}.fp .ds{margin-top:14px;max-width:40em;font-size:clamp(17px,1.8vw,23px)}.fp .lb{margin-top:18px;color:var(--mute)}.fp ul{list-style:none;padding:0;margin-top:6px;columns:2 300px;column-gap:40px}.fp li{break-inside:avoid;padding:9px 0;border-bottom:1px solid var(--line);font-size:clamp(17px,1.8vw,23px)}.fp .kp{margin-top:18px;font-size:clamp(17px,1.8vw,23px)}.fp .ex{margin-top:20px;border-left:4px solid var(--acc);padding-left:16px;font-size:clamp(18px,2vw,26px);letter-spacing:-.015em}
@media (max-width:720px){.steps{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
</style>
</head>
